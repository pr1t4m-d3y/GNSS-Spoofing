# Copy to .env (`make up` does this for you). Never commit .env.

# Local development only: skip API-key checks. In any shared or deployed
# environment set this to false and provide GNSS_API_KEY.
GNSS_AUTH_DISABLED=true

# Shared secret expected in the X-API-Key header. Generate one with:
#   openssl rand -hex 32
GNSS_API_KEY=

# Comma-separated browser origins allowed to call the API directly.
# Leave empty when the dashboard talks to the API through its own /api proxy.
GNSS_CORS_ORIGINS=

# Model artefact and its manifest (the manifest path defaults to <model>.manifest.json).
GNSS_MODEL_PATH=models/gnss_iforest.pkl

# Limits.
GNSS_MAX_FILE_BYTES=10485760
GNSS_MAX_FILE_ROWS=50000
GNSS_MAX_CHANNELS=64
GNSS_MAX_SESSIONS=256

GNSS_LOG_LEVEL=INFO
